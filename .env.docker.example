# Copy this file to .env beside compose.yaml on each computer.
APP_PORT=8080
POSTGRES_DB=moratorium
POSTGRES_USER=moratorium
# Use a strong URL-safe password: letters, numbers, underscore, dot, or hyphen.
POSTGRES_PASSWORD=replace_with_a_strong_local_password
CORS_ORIGIN=http://localhost:8080
# Keep development for local HTTP. Use production only when serving through HTTPS.
NODE_ENV=development

